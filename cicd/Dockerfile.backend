# Backend image for Substrait. Built from the REPO ROOT, so COPY paths are
# repo-relative (COPY backend/...). The contract: EXPOSE 8000, GET /health, API under /api.
FROM python:3.12-slim
RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt
COPY backend/ .
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
