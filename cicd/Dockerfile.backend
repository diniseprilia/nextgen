# Substrait backend image. Built from the REPO ROOT.
# Contract: EXPOSE 8000, GET /health, API under /api. No frontend/ dir, so this
# process also serves the NextGen static UI (index.html + js/css).
FROM node:22-alpine
RUN apk update && apk upgrade --no-cache
WORKDIR /app

COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev

COPY css ./css
COPY design-system ./design-system
COPY js ./js
COPY mockups/mockups.css ./mockups/mockups.css
COPY index.html ./
COPY server/src ./server/src
COPY server/package.json ./server/package.json

EXPOSE 8000
ENV NODE_ENV=production
ENV PORT=8000

CMD ["node", "server/src/index.js"]
